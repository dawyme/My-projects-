{
  "name": "hvac-admin-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Production backend + admin API for HVAC, Refrigeration and Automotive AC website",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "migrate": "node prisma/migrate.js",
    "migrate:dev": "prisma migrate dev",
    "generate": "prisma generate",
    "seed": "node prisma/seed.js",
    "setup": "node prisma/migrate.js && node prisma/seed.js",
    "test": "node tests/run-all.js",
    "test:api": "node tests/api.test.js",
    "test:ui": "node tests/ui.test.js",
    "test:site": "node tests/site.test.js",
    "test:suppliers": "node tests/suppliers.test.js",
    "test:payments": "node backend/tests/payments.test.js",
    "test:tilopay": "node backend/tests/tilopay-unit.test.js",
    "test:bootstrap-super-admin": "node tests/bootstrap-super-admin.test.js",
    "bootstrap:super-admin": "node scripts/bootstrap-super-admin.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^6.19.3",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "sharp": "^0.35.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "jsdom": "29.1.1",
    "prisma": "^6.1.0"
  }
}
