# Backend environment — copy to backend/.env (or the repo-root .env) and fill in.
# Full documentation: see DEPLOYMENT.md

# Database (Supabase PostgreSQL or local SQLite)
DATABASE_URL="postgresql://postgres:password@db.xyz.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db.xyz.supabase.co:5432/postgres"

# Supabase
SUPABASE_URL="https://xyz.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Auth & security
JWT_SECRET="your-jwt-secret-key-at-least-32-chars-long"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key-at-least-32-chars-long"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="14"
COOKIE_SECURE="true"

# Server
PORT=3001
NODE_ENV="development"
CORS_ORIGINS="*"

# Email (SMTP) — falls back to backend/data/outbox.log when unset
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="no-reply@example.com"
SMTP_PASS=""
SMTP_FROM="N&D's <no-reply@example.com>"

# Transactional email (Resend preferred; SMTP remains the fallback)
RESEND_API_KEY=""
RESEND_FROM="N&D's <no-reply@your-verified-domain.com>"
BUSINESS_NOTIFICATION_EMAIL="ndsairconditioning@gmail.com"

# --- Payment gateways ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV="live"
PAYPAL_WEBHOOK_ID=""
PAYPAL_WEBHOOK_SECRET=""
WIPAY_API_TOKEN=""
WIPAY_MERCHANT_ID=""
WIPAY_BASE_URL="https://www.wipaycaribbean.com/api/checkout"
WIPAY_WEBHOOK_SECRET=""
TILOPAY_API_KEY=""
TILOPAY_API_USER=""
TILOPAY_API_PASSWORD=""
TILOPAY_BASE_URL="https://app.tilopay.com/api/checkout"
TILOPAY_WEBHOOK_SECRET=""
PAYMENT_SANDBOX_SECRET="dev-sandbox-secret"
