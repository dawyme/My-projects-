# Backend environment — copy to backend/.env (or the repo-root .env) and fill in.
# Full documentation: see DEPLOYMENT.md

# Database (Supabase PostgreSQL or local SQLite)
DATABASE_URL="postgresql://postgres:password@db.xyz.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db.xyz.supabase.co:5432/postgres"

# Supabase
SUPABASE_URL="https://xyz.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Auth & security
JWT_SECRET="your-jwt-secret-key-at-least-32-chars-long"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key-at-least-32-chars-long"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="14"
COOKIE_SECURE="true"

# Server
PORT=3001
NODE_ENV="development"
CORS_ORIGINS="*"

# Email (SMTP) — falls back to backend/data/outbox.log when unset
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="no-reply@example.com"
SMTP_PASS=""
SMTP_FROM="N&D's <no-reply@example.com>"

# --- Payment gateways ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV="live"
PAYPAL_WEBHOOK_ID=""
PAYPAL_WEBHOOK_SECRET=""
WIPAY_API_TOKEN=""
WIPAY_MERCHANT_ID=""
WIPAY_BASE_URL="https://www.wipaycaribbean.com/api/checkout"
WIPAY_WEBHOOK_SECRET=""
TILOPAY_API_KEY=""
TILOPAY_API_USER=""
TILOPAY_API_PASSWORD=""
TILOPAY_BASE_URL="https://app.tilopay.com/api/checkout"
TILOPAY_WEBHOOK_SECRET=""
PAYMENT_SANDBOX_SECRET="dev-sandbox-secret"

# --- Supplier Marketplace ---
# Dedicated key for supplier credential encryption (AES-256-GCM). Falls back to
# JWT_SECRET when unset — set this in production. Rotating it requires
# re-entering each integration's credentials.
SUPPLIER_CREDENTIALS_KEY=""

# Comma-separated hostnames allowed even though they are private/loopback
# (on-premise supplier appliances, local test stubs). Cloud metadata addresses
# are never permitted.
SUPPLIER_ALLOWED_HOSTS=""

# Set to "true" on every instance except the one that should run the automatic
# supplier sync scheduler.
SUPPLIER_SCHEDULER_DISABLED="false"

# Rate-limit budgets (requests per minute per IP)
RATE_LIMIT_API_MAX="300"
RATE_LIMIT_WRITE_MAX="120"
RATE_LIMIT_SUPPLIER_WRITE_MAX="400"

# Optional runtime for the SFTP supplier connector: npm install ssh2

# --- Super Admin bootstrap (scripts/bootstrap-super-admin.js) ---
# Optional defaults for the CLI — command-line flags always take precedence.
# Never commit real values here.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_PASSWORD=""
# Required in addition to --confirm when NODE_ENV=production — see
# backend/docs/SUPER_ADMIN_BOOTSTRAP.md.
SUPER_ADMIN_BOOTSTRAP_PRODUCTION_ACK=""
