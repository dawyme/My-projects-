# Backend environment — copy to backend/.env (or the repo-root .env) and fill in.
# Full documentation: see DEPLOYMENT.md

# Database
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Auth
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS="30"

# Email (Resend preferred; SMTP remains the fallback)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="N&D's <no-reply@ndsairconditioning.com>"
RESEND_API_KEY=""
RESEND_FROM="N&D's <no-reply@ndsairconditioning.com>"
BUSINESS_NOTIFICATION_EMAIL="ndsairconditioning@gmail.com"

# Optional — application
NODE_ENV="production"
PORT="3000"
CORS_ORIGIN="https://www.ndsairconditioning.com"
