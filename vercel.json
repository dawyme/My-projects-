{
  "version": 2,
  "outputDirectory": ".",
  "functions": {
    "api/index.js": {
      "includeFiles": "{backend/**,node_modules/.prisma/**}"
    }
  },
  "redirects": [
    { "source": "/admin", "destination": "/admin/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/health", "destination": "/api" },
    { "source": "/admin/(.*)", "destination": "/admin/$1" },
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
}
