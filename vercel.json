{
  "version": 2,
  "outputDirectory": ".",
  "functions": {
    "api/index.js": {
      "includeFiles": "{backend/**,node_modules/.prisma/**}"
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://ndsairconditioning.com/$1",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "www.ndsairconditioning.com"
        }
      ]
    },
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/health",
      "destination": "/api"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/reminders/run",
      "schedule": "0 13 * * *"
    }
  ]
}
