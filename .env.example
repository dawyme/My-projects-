# ============================================================================
# N&D's Air Conditioning & Refrigeration — environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# Full documentation: see DEPLOYMENT.md
# ============================================================================

# --- Database (Supabase PostgreSQL in production, SQLite file for local dev) ---
DATABASE_URL="postgresql://postgres:password@db.xyz.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db.xyz.supabase.co:5432/postgres"
# Local testing instead:
# DATABASE_URL="file:./backend/data/app.db"

# --- Supabase (optional; used for status checks) ---
SUPABASE_URL="https://xyz.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Authentication & security ---
JWT_SECRET="at-least-32-random-characters"
JWT_REFRESH_SECRET="another-at-least-32-random-characters"
ACCESS_TOKEN_TTL="15m"              # optional
REFRESH_TOKEN_TTL_DAYS="14"         # optional
COOKIE_SECURE="true"                # true behind HTTPS (Vercel/Supabase)
COOKIE_DOMAIN=""                    # optional, for cross-subdomain cookies
PUBLIC_FORM_LIMIT="20"              # public form submissions per hour per IP

# --- Server ---
PORT=3001
NODE_ENV="development"              # use "production" in deployment
CORS_ORIGINS="*"                    # comma-separated allow-list, or *

# --- Email (SMTP) — when unset, outgoing mail is logged to backend/data/outbox.log ---
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"                     # use 465 for implicit TLS
SMTP_USER="no-reply@example.com"
SMTP_PASS=""
SMTP_FROM="N&D's <no-reply@example.com>"

# ============================================================================
# Payment gateways — see DEPLOYMENT.md § Payments
# Gateways enabled in Admin → Settings → Payments but missing their keys run in
# test mode during development and are rejected in production.
# ============================================================================

# --- Stripe (Checkout Sessions + webhook capture) ---
STRIPE_SECRET_KEY="sk_live_..."     # or sk_test_... in development
STRIPE_WEBHOOK_SECRET="whsec_..."   # from Stripe dashboard → webhooks

# --- PayPal (Orders v2 + webhook capture) ---
PAYPAL_CLIENT_ID="..."
PAYPAL_CLIENT_SECRET="..."
PAYPAL_ENV="live"                   # or "sandbox"
PAYPAL_WEBHOOK_ID=""                # optional, used in webhook verification
PAYPAL_WEBHOOK_SECRET=""            # optional HMAC secret for webhook verification

# --- WiPay (Caribbean cards & vouchers) ---
WIPAY_API_TOKEN="..."
WIPAY_MERCHANT_ID="..."
WIPAY_BASE_URL="https://www.wipaycaribbean.com/api/checkout"  # override for your region
WIPAY_WEBHOOK_SECRET=""             # optional HMAC secret for webhook verification

# --- Tilopay ---
TILOPAY_API_KEY="..."
TILOPAY_API_USER=""
TILOPAY_API_PASSWORD=""
TILOPAY_BASE_URL="https://app.tilopay.com/api/checkout"       # override for your region
TILOPAY_WEBHOOK_SECRET=""           # optional HMAC secret for webhook verification

# --- Sandbox webhook secret (development only; ignored in production) ---
# When a gateway has no keys and NODE_ENV != production, webhook tests sign
# payloads with this secret. Never rely on it in production.
PAYMENT_SANDBOX_SECRET="dev-sandbox-secret"
